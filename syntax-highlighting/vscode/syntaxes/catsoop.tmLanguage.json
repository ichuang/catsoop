{
  "name": "CAT-SOOP",
  "scopeName": "text.html.markdown.catsoop",
  "patterns": [
    {
      "include": "#catsoop-comments"
    },
    {
      "include": "#python-blocks"
    },
    {
      "include": "#question-blocks"
    },
    {
      "include": "text.html.markdown"
    }
  ],
  "repository": {
    "catsoop-comments": {
      "name": "comment.block.catsoop",
      "begin": "<comment>",
      "end": "</comment>",
      "beginCaptures": {
        "0": {
          "name": "comment.block.catsoop"
        }
      },
      "endCaptures": {
        "0": {
          "name": "comment.block.catsoop"
        }
      }
    },
    "python-blocks": {
      "name": "meta.embedded.block.python.catsoop",
      "begin": "(<)(python)(>)",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.tag.begin.html"
        },
        "2": {
          "name": "entity.name.tag.html"
        },
        "3": {
          "name": "punctuation.definition.tag.end.html"
        }
      },
      "end": "(</)(python)(>)",
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.tag.begin.html"
        },
        "2": {
          "name": "entity.name.tag.html"
        },
        "3": {
          "name": "punctuation.definition.tag.end.html"
        }
      },
      "patterns": [
        {
          "include": "source.python"
        }
      ]
    },
    "question-blocks": {
      "name": "meta.embedded.block.python.catsoop.question",
      "begin": "(<)(question)\\s+([^>]*)(>)",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.tag.begin.html"
        },
        "2": {
          "name": "entity.name.tag.html"
        },
        "3": {
          "name": "string.unquoted.html.attribute.catsoop",
          "patterns": [
            {
              "include": "text.html.basic#attribute"
            }
          ]
        },
        "4": {
          "name": "punctuation.definition.tag.end.html"
        }
      },
      "end": "(</)(question)(>)",
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.tag.begin.html"
        },
        "2": {
          "name": "entity.name.tag.html"
        },
        "3": {
          "name": "punctuation.definition.tag.end.html"
        }
      },
      "patterns": [
        {
          "include": "source.python"
        }
      ]
    }
  }
}
