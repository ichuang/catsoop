{
  "name": "catsoop-syntax",
  "displayName": "CAT-SOOP",
  "description": "Syntax highlighting for .catsoop files",
  "version": "0.0.2",
  "engines": {
    "vscode": "^1.0.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "catsoop",
        "extensions": [
          ".catsoop"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "catsoop",
        "scopeName": "text.html.markdown.catsoop",
        "path": "./syntaxes/catsoop.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.python.catsoop": "python",
          "meta.embedded.block.python.catsoop.question": "python"
        }
      },
      {
        "scopeName": "catsoop.inline",
        "path": "./syntaxes/catsoop-injections.tmLanguage.json",
        "injectTo": [
          "text.html.markdown",
          "text.html.markdown.catsoop"
        ],
        "embeddedLanguages": {
          "meta.embedded.inline.pytohn.catsoop": "python"
        }
      }
    ]
  },
  "repository": "https://catsoop.org/git/catsoop/catsoop"
}
